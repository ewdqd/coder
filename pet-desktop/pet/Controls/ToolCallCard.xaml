<UserControl x:Class="pet.Controls.ToolCallCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="400">
    <Border Background="#2A2A3E" CornerRadius="6" Padding="10,6" Margin="0,2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行：工具图标 + 工具名 + 状态 + 展开按钮 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="ToolIcon" Text="🔧" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="ToolNameLabel" Text="Bash"
                           Foreground="#BBCCEE" FontSize="12.5"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLabel" Text="⏳ Running..."
                           Foreground="#FFCC66" FontSize="11.5"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="ExpandButton" Content="▼"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Foreground="#8888AA" FontSize="10"
                        Click="ExpandButton_Click" Cursor="Hand"
                        Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 可展开的输出内容 -->
            <Border x:Name="OutputPanel" Grid.Row="1"
                    Background="#1A1A2E" CornerRadius="4"
                    Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock x:Name="OutputText" Foreground="#99AACC"
                           FontFamily="Consolas, Courier New, monospace"
                           FontSize="11.5" LineHeight="16"
                           TextWrapping="Wrap" MaxHeight="200"
                           TextTrimming="CharacterEllipsis"
                           xml:space="preserve"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
